{
  "name": "vscode-wsl-action-buttons",
  "displayName": "WSL Action Buttons",
  "description": "Quick terminal actions for VS Code and WSL: paste and execute, OpenCode, copy output and clear terminal.",
  "version": "0.2.0",
  "publisher": "omaciasd",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wslActionButtons.pasteAndExecute",
        "title": "WSL Action Buttons: Pegar y ejecutar",
        "icon": "$(clippy)"
      },
      {
        "command": "wslActionButtons.openOpenCode",
        "title": "WSL Action Buttons: Abrir OpenCode",
        "icon": "$(terminal)"
      },
      {
        "command": "wslActionButtons.copyAllOutput",
        "title": "WSL Action Buttons: Copiar output",
        "icon": "$(copy)"
      },
      {
        "command": "wslActionButtons.clearTerminal",
        "title": "WSL Action Buttons: Limpiar terminal",
        "icon": "$(clear-all)"
      }
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  }
}
